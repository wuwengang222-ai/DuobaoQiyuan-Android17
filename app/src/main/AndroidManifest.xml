<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- MLKit/WebKit libraries may declare network permissions. Local game
       and bundled OCR assets are intentionally offline, so strip them. -->
  <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove"/>
  <application android:label="夺宝奇缘·双部曲" android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
    <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
